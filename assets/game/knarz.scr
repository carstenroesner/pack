    rechteck 850 686 22 100 #6B4A2E

    objekt tuer_halle "Tür zur Halle"
        klickkasten 90 390 170 330
        beschreibung "Die Tür zurück in die Halle."
        rechteck 100 400 150 300 #6B3A22
        rechteck 115 420 55 100 #5A2F1B
        rechteck 180 420 55 100 #5A2F1B
        kreis 232 560 9 #D8B04A
        bei gehe:
            raum halle von_kueche
        bei oeffne:
            raum halle von_kueche

    objekt kerze_o "Kerzenstummel"
        klickkasten 690 610 55 55
        beschreibung "Ein Kerzenstummel auf dem Tisch. Nicht viel, aber mehr als nichts."
        rechteck 700 628 26 32 #E8DDB5
        rechteck 711 618 4 12 #3A2A1A -
        bei nimm:
            sage "Ein Stummel. Besser als gar nichts."
            gib kerze
            verstecke

    objekt kessel "Kessel"
        klickkasten 1040 400 200 170
        ziel bei_kessel
        beschreibung "Ein Kessel auf dem Herd. Er blubbert leise und riecht nach Gemüse von gestern."
        pfad #3A3A46 "M1050 440 Q1040 540 1100 560 L1180 560 Q1240 540 1230 440 Z"
        ellipse 1140 440 92 18 #55556A
        ellipse 1140 442 78 12 #5EE07A -
        kreis 1120 432 8 #8CFFA0 -
        kreis 1165 436 6 #8CFFA0 -
        bei schau:
            wenn kette_gefunden:
                sage "Nur noch Suppe. Und das Gefühl, etwas Gutes getan zu haben."
            sonst:
                sage "Ein Kessel auf dem Herd. In der Suppe glitzert etwas Metallisches."
        bei benutze mit kelle:
            wenn kette_gefunden:
                sage "Mehr als Suppe finde ich da nicht."
            sonst:
                sage "Ich fische ein wenig im Kessel. Es klirrt."
                warte 0.4
                setze kette_gefunden
                gib kette
                sage "Eine Rasselkette! Wer kocht denn mit so etwas?"
        bei nimm:
            sage "Der Kessel ist heiß. Und er hat mir nichts getan."

    objekt kelle_o "Schöpfkelle"
        klickkasten 1330 240 90 220
        beschreibung "Eine Schöpfkelle an der Wand. Sie hängt dort wie eine Einladung."
        rechteck 1370 250 10 150 #B8B8C8
        ellipse 1375 420 30 22 #B8B8C8
        bei nimm:
            sage "Die kann ich sicher noch gebrauchen."
            gib kelle
            verstecke

    objekt gerda "Spinne Gerda"
        klickkasten 740 200 120 100
        beschreibung "Eine Spinne an einem Faden. Sie sieht mich an. Mit allen Augen."
        pfad - #CFCFE8 dick 2 "M800 0 L800 225"
        pfad - #1B1030 dick 4 "M785 245 L750 225 M785 255 L745 262 M815 245 L850 225 M815 255 L855 262"
        kreis 800 250 22 #2B1B3B
        kreis 792 244 5 #FFFFFF -
        kreis 808 244 5 #FFFFFF -
        bei rede:
            dialog gerda
        bei nimm:
            sage "Gerda zieht sich ein Stück nach oben. Ich lasse sie lieber."

// ======================================================================
// Gespräche
// ======================================================================

dialog rabe
    start:
        wahl:
            option "Hallo, Edgar. Schöne Federn.":
                sage rabe "Kraah! Federn glänzen nicht. Knöpfe glänzen."
                weiter start
            option "Was weißt du über das Haus?":
                sage rabe "Eine Kette fehlt. Ein Geist friert. Eine Spinne spinnt."
                sage rabe "Mehr sage ich nicht. Ohne Gegenleistung."
                weiter start
            option "Hast du etwas für mich?":
                sage rabe "Etwas Rostiges. Aber nur gegen etwas Glänzendes."
                weiter start
            option "Ich muss weiter.":
                sage rabe "Kraah. Komm wieder, wenn es glänzt."
                beende

dialog knarz
    start:
        wahl:
            option "Wer sind Sie?":
                sage knarz "Ich bin Herr von Knarz. Das Haus gehört meiner Familie, mir gehört nur der Ärger."
                weiter start
            option "Warum spuken Sie hier?":
                sage knarz "Meine Rasselkette ging verloren. Ohne Kette kein Spuk. Ohne Spuk keine Ruhe."
                weiter start
            option "Ich habe etwas gefunden." wenn hat kette:
                sage knarz "Sie rasselt! Ich höre es! Gib sie mir, bitte. Sagt man das so?"
                weiter start
            option "Ich gehe wieder.":
                sage knarz "Das tun sie alle. Aber du kommst zurück. Du bist die Erste, die meine Kette hat."
                beende

dialog gerda
    start:
        wahl:
            option "Hallo, Gerda.":
                sage gerda "Hallo, Besucher. Ich webe gerade. Störe nicht."
                weiter start
            option "Kennst du dich im Haus aus?":
                sage gerda "Ich sehe alles. Von oben. Der Kessel ist nicht so leer, wie er aussieht."
                weiter start
            option "Tschüss.":
                sage gerda "Tschüss. Ich bleibe hier. Ich habe Zeit."
                beende

// ======================================================================
// Skripte
// ======================================================================

skript start:
    zwischensequenz:
        warte 0.5
        sage "Halloween, Mitternacht, und ich habe keine Taschenlampe dabei."
        sage "Das Haus soll voller Geister stecken. Perfekt für meine Reportage."
        sage "Vielleicht kann ich mich hier irgendwie nützlich machen."

skript rabe_tausch:
    wenn hat knopf:
        entferne knopf
        sage rabe "Kraah! Glänzt! Meins!"
        sage "Gern geschehen."
        sage rabe "Dafür das hier. Rostig. Wie ich."
        gib schluessel
        setze rabe_zufrieden
    sonst:
        sage rabe "Ich warte auf etwas, das glänzt."

skript anzuenden:
    zwischensequenz:
        sage "Streichholz, Kerze, Daumen drücken."
        warte 0.6
        setze halle_hell
        warte 0.8
